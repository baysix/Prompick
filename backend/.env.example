# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다.

# ════════════════════════════════════════════════════════════════
#  Supabase
#  대시보드 > Project Settings 에서 값을 복사한다.
# ════════════════════════════════════════════════════════════════

# Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings > API Keys > secret key  (sb_secret_... 로 시작)
# ⚠️ RLS를 통째로 무시하는 키다. 서버에만 두고 절대 프론트로 내보내지 않는다.
SUPABASE_SECRET_KEY=

# 예전에 만든 프로젝트만 채운다. (Settings > API > JWT Settings > JWT Secret)
# 최근 프로젝트는 비워두면 JWKS 공개키로 검증한다.
SUPABASE_JWT_SECRET=

# ── 데이터베이스 ──────────────────────────────────────────────────
# Settings > Database > Connection string 에서 복사한다.
#
# ⚠️ 연결을 두 개로 나눈다. 하나로 합치면 Flyway가 깨진다.
#   DB_POOL_URL    : 앱 쿼리용. Transaction 모드 (포트 6543)
#   DB_SESSION_URL : 마이그레이션용. Session 모드 (포트 5432)
#
# ⚠️ Direct connection(db.<ref>.supabase.co)은 IPv6 전용이라 대부분의 환경에서 연결되지 않는다.
#    반드시 pooler 주소를 쓴다.
#
# 형식 예시 (aws-0-ap-northeast-2 부분은 프로젝트 리전에 맞게)
DB_POOL_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DB_SESSION_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 풀러를 쓸 때 사용자명은 postgres.<프로젝트ref> 형식이다
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=
DB_POOL_SIZE=10

# ── 스토리지 ────────────────────────────────────────────────────
# SUPABASE(기본) 또는 LOCAL(네트워크 없이 개발할 때)
STORAGE_TYPE=SUPABASE
# 대시보드 > Storage 에서 아래 세 버킷을 만든다.
#   uploads        : 비공개. 사용자가 올린 원본 사진
#   outputs        : 비공개. 생성 결과물 (서명 URL로만 접근)
#   public-assets  : 공개.   템플릿 예시·가이드 이미지 (검색 노출·OG 이미지용)
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_OUTPUT_BUCKET=outputs
SUPABASE_PUBLIC_BUCKET=public-assets

# STORAGE_TYPE=LOCAL 일 때만 사용
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# ════════════════════════════════════════════════════════════════
#  서버
# ════════════════════════════════════════════════════════════════
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ════════════════════════════════════════════════════════════════
#  결제·본인인증: 포트원 V2  (6단계에서 사용)
# ════════════════════════════════════════════════════════════════
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=

# ════════════════════════════════════════════════════════════════
#  외부 AI 제공사  (7단계에서 사용)
#  개발 기본값은 MOCK. 실제 API는 비용이 드므로 명시적으로 켤 때만 쓴다.
# ════════════════════════════════════════════════════════════════
AI_PROVIDER=MOCK
HIGGSFIELD_API_KEY=
