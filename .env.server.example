# =============================================================================
# 서버(.env) 본보기
#
# 이 파일을 서버에서 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
#
#   cp .env.server.example .env && nano .env
#
# compose 가 이 파일을 두 가지로 쓴다.
#   1. ${DOMAIN} 같은 치환값 — docker-compose.yml 안에서 쓰인다
#   2. api 컨테이너의 환경변수 — env_file 로 통째로 들어간다
# =============================================================================

# --- 도메인 -------------------------------------------------------------------
# Caddy 가 이 이름으로 인증서를 받는다. 이 서버를 가리키도록 DNS 를 먼저 맞춰둘 것.
# www 없이 적는다. Caddy 가 www 로 온 사람을 이 주소로 넘겨준다.
DOMAIN=yspace.kr

# --- 프론트(빌드 시점에 코드에 박힌다) -------------------------------------------
# 값을 바꾸면 다시 빌드해야 한다. docker compose up -d --build
NEXT_PUBLIC_SUPABASE_URL=https://ijubptwccmhvlkhygaua.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 데이터베이스 (Supabase) -----------------------------------------------------
# 애플리케이션 쿼리용. 트랜잭션 풀러(6543).
DB_POOL_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 마이그레이션용. 세션 연결(5432). 풀러로 DDL 을 돌리면 마이그레이션이 깨진다.
DB_SESSION_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_USERNAME=
DB_PASSWORD=

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://ijubptwccmhvlkhygaua.supabase.co
# 서버 전용 키(sb_secret_...). RLS 를 우회하므로 절대 프론트로 내보내지 않는다.
SUPABASE_SECRET_KEY=

# --- 열쇠 ----------------------------------------------------------------------
# 제공사 API 키를 DB 에 봉인할 때 쓴다. 이 값이 바뀌면 저장해 둔 키를 못 읽는다.
# 한 번 정하면 바꾸지 않는다. 지금 쓰던 값을 그대로 옮길 것.
PROMPICK_MASTER_KEY=

# --- Supabase 토큰 검증 ----------------------------------------------------------
# 예전 방식(HS256 대칭키) 프로젝트만 채운다. 비워두면 JWKS(비대칭키)로 검증하고,
# 최근에 만든 프로젝트는 비워두는 것이 맞다.
SUPABASE_JWT_SECRET=

# --- AI 제공사 키 (선택) ----------------------------------------------------------
# 관리자 화면에 넣어 둔 키가 항상 우선한다. 이미 DB 에 봉인해 둔 키가 있으면
# (= PROMPICK_MASTER_KEY 를 그대로 옮겼으면) 여기는 비워둬도 된다.
# 화면에 아직 아무것도 없을 때만 쓰이는 대비책이다.
#OPENAI_API_KEY=
#HIGGSFIELD_API_KEY=

# --- CORS ----------------------------------------------------------------------
# 이제 브라우저가 같은 도메인으로 API 를 부르므로 실제로는 쓰일 일이 없다.
# 그래도 비워두지 않는다 — 나중에 다른 출처에서 부를 일이 생겼을 때 기준이 된다.
CORS_ALLOWED_ORIGINS=https://yspace.kr

# --- 운영 정책 -------------------------------------------------------------------
# 무료 제작은 매출 없이 원가만 나간다. 사람이 붙기 시작하면 이 숫자가 곧 지출이다.
FREE_DAILY_LIMIT=1
# 계정을 여러 개 만들어 무료 횟수를 무한히 쓰는 것을 막는다. 운영에서는 반드시 켠다.
FREE_REQUIRE_IDENTITY=true

# --- 저장소 ---------------------------------------------------------------------
STORAGE_TYPE=SUPABASE
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_OUTPUT_BUCKET=outputs
SUPABASE_PUBLIC_BUCKET=public-assets
