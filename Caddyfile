# =============================================================================
# 바깥에서 들어오는 모든 요청이 지나는 곳
#
# 인증서는 Caddy 가 알아서 받고 알아서 갱신한다. 만료일을 달력에 적어둘 필요가 없다.
# 처음 뜰 때 80 번 포트로 소유 확인을 하므로, 도메인이 이 서버를 가리킨 뒤에 올려야 한다.
# =============================================================================

# www 로 온 사람을 도메인 하나로 모은다.
#
# 둘 다 열어두면 같은 화면이 두 주소로 존재하게 된다. 검색엔진은 그것을 서로 다른
# 페이지로 세고, 로그인 쿠키도 주소마다 따로 생겨 "로그인했는데 로그아웃돼 있는" 일이 난다.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# 압축해서 보낸다. 우리 서버가 내보내는 것은 대부분 HTML·JS·JSON 이라 효과가 크다.
	encode gzip zstd

	# --- 백엔드 -------------------------------------------------------------
	# /api 와 문서, 헬스체크만 백엔드로 보낸다. 나머지는 전부 프론트 몫이다.
	#
	# 브라우저가 이 주소(같은 도메인)로 API 를 부르므로 CORS 자체가 생기지 않는다.
	# 다른 출처가 아니면 브라우저가 사전 요청을 보내지 않기 때문이다.
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /actuator/* {
		reverse_proxy api:8080
	}

	# API 문서는 운영에서 열어둘 이유가 없다. 프롬프트 구조와 관리자 API 가 다 드러난다.
	# 필요하면 SSH 터널로 본다:  ssh -L 8080:localhost:8080 서버
	handle /docs* {
		respond 404
	}
	handle /api-docs* {
		respond 404
	}

	# --- 프론트 -------------------------------------------------------------
	handle {
		reverse_proxy web:3000
	}

	# 사람이 읽을 수 있는 형식으로 남긴다. 무엇이 느린지 볼 때 이것부터 본다.
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
